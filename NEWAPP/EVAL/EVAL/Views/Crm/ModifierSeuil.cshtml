<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title text-center">Modifier le taux du seuil</h4>
                    <form method="post" action="/update-seuil">
                        <div class="form-group">
                            <label for="newSeuil">Nouveau seuil (%)</label>
                            <input id="newSeuil" name="newSeuil" type="number" step="0.01" class="form-control" required />
                        </div>
                        <div class="text-center mt-3">
                            <button type="submit" class="btn btn-primary">Mettre à jour</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
